<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only by default. Cleartext is allowed solely for the emulator/localhost
  addresses so you can point a debug build at `node server/server.js` locally.
  Your real vault URL must be HTTPS (WebCrypto + PWA require a secure context).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
