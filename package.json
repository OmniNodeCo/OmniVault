{
  "name": "omnivault",
  "version": "1.0.4",
  "description": "Zero-knowledge encrypted vault for passwords, notes and images. Web + Android (PWA), Docker-ready, zero npm dependencies.",
  "main": "server/server.js",
  "private": true,
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "test": "node --test --test-force-exit \"tests/*.test.js\"",
    "check": "find server public tests -name '*.js' -print0 | xargs -0 -n1 node --check",
    "lan": "node server/server.js --lan"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "SEE LICENSE IN README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/OmniNodeCo/OmniVault.git"
  },
  "keywords": [
    "vault",
    "password-manager",
    "encryption",
    "zero-knowledge",
    "pwa",
    "android"
  ]
}
